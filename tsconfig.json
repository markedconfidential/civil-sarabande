{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@civil-sarabande/shared": ["packages/shared/src/index.ts"]
    },
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "composite": true
  }
}
