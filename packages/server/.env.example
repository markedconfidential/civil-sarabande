# Civil Sarabande server configuration.
#
# Bun loads .env and .env.local automatically. Copy this file to .env (or let
# scripts/dev-local.sh write .env.local for you) and fill in the values.
#
# Two ready-made setups are shown for each chain variable:
#   [anvil]   local Anvil chain, dev auth, no Privy, no testnet
#   [sepolia] Base Sepolia with Privy auth (docs/playtest-runbook.md)

# ---- runtime ----------------------------------------------------------------

# development | production. AUTH_MODE=dev is refused in production.
NODE_ENV=development

# HTTP/WebSocket port.
PORT=3001

# SQLite file. Defaults to packages/server/data/civil-sarabande.db.
# Use :memory: for a throwaway database.
# DATABASE_PATH=./data/civil-sarabande.db

# debug | info | warn | error
LOG_LEVEL=info

# Comma-separated browser origins. Required in production; ignored in
# development where every origin is allowed.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- auth -------------------------------------------------------------------

# privy | dev
#   privy: bearer tokens are Privy access tokens; wallets come from Privy.
#   dev:   bearer tokens are "dev:<userId>"; any well-formed wallet is
#          accepted; POST /dev/faucet mints MockUSDC. Never in production.
AUTH_MODE=dev

# Required only when AUTH_MODE=privy.
# PRIVY_APP_ID=your-privy-app-id
# PRIVY_APP_SECRET=your-privy-app-secret

# ---- chain ------------------------------------------------------------------

# 31337 (Anvil) | 84532 (Base Sepolia)
CHAIN_ID=31337                                      # [anvil]
# CHAIN_ID=84532                                    # [sepolia]

# JSON-RPC endpoint. BASE_SEPOLIA_RPC_URL is accepted as an alias.
RPC_URL=http://127.0.0.1:8545                       # [anvil]
# RPC_URL=https://sepolia.base.org                  # [sepolia]

# GameEscrow v2 address (packages/contracts/deployments/*.json after deploy).
GAME_ESCROW_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000   # [anvil] from deployments/local.json
# GAME_ESCROW_CONTRACT_ADDRESS=0x...                                       # [sepolia] from deployments/base-sepolia.json

# USDC token address.
USDC_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000          # [anvil] MockUSDC from deployments/local.json
# USDC_CONTRACT_ADDRESS=0x036CbD53842c5426634e7929C8C4E5b8c0C5b6E8        # [sepolia] Circle's Base Sepolia USDC

# Private key of the wallet that signs settleGame/cancelGame. Must match the
# escrow's serverAddress and hold a little ETH for gas.
# [anvil] Anvil account 9 — a PUBLIC, well-known test key. Never fund it on
#         a real network.
SERVER_WALLET_PRIVATE_KEY=0x2a871d0798f97d79848a013d4936a73bf4cc922c825d33c1cf7073dff6d409c6
# [sepolia] a fresh key you control:
# SERVER_WALLET_PRIVATE_KEY=0x...

# ---- play -------------------------------------------------------------------

# Seconds a player has to act before being forfeited. 0 disables the clock.
TURN_TIMEOUT_SECONDS=120

# true: verify deposits on chain and settle games from the server wallet.
# false: engine-only mode; funding/join are trusted, nothing touches the
#        chain, and the chain variables above become optional.
SETTLEMENT_ENABLED=true
