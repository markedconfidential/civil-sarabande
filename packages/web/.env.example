# Civil Sarabande web client configuration.
#
# Copy to `.env` (git-ignored) and fill in the values for your setup.
# Every variable is read and validated once in src/lib/config.ts; problems are
# shown on the home page instead of crashing the app.
#
# Two ready-made profiles follow: LOCAL (Anvil, no testnet, no Privy) and
# BASE SEPOLIA (real testnet with Privy embedded wallets). Uncomment one.

# ============================================================================
# LOCAL — Anvil + dev auth (what scripts/dev-local.sh writes for you)
# ============================================================================

# Game server REST base URL (no trailing slash)
VITE_API_URL=http://localhost:3001
# Game server WebSocket base URL; defaults to VITE_API_URL with ws:// when unset
VITE_WS_URL=ws://localhost:3001

# "dev" shows the four preset Anvil identities on /dev-login; "privy" uses Privy
VITE_AUTH_MODE=dev
# Only required when VITE_AUTH_MODE=privy
VITE_PRIVY_APP_ID=

# 31337 = local Anvil, 84532 = Base Sepolia
VITE_CHAIN_ID=31337
VITE_RPC_URL=http://127.0.0.1:8545

# Contract addresses. After `forge script script/DeployLocal.s.sol` copy these
# from packages/contracts/deployments/local.json ("escrow" and "usdc").
VITE_ESCROW_CONTRACT_ADDRESS=fill from packages/contracts/deployments/local.json
VITE_USDC_CONTRACT_ADDRESS=fill from packages/contracts/deployments/local.json

# Optional block explorer base URL for transaction links; leave empty on Anvil
VITE_EXPLORER_URL=

# ============================================================================
# BASE SEPOLIA — Privy auth + real testnet (see docs/playtest-runbook.md)
# ============================================================================

# VITE_API_URL=https://your-server.example.com
# VITE_WS_URL=wss://your-server.example.com
# VITE_AUTH_MODE=privy
# VITE_PRIVY_APP_ID=your-privy-app-id
# VITE_CHAIN_ID=84532
# VITE_RPC_URL=https://sepolia.base.org
# # From packages/contracts/deployments/base-sepolia.json after Deploy.s.sol
# VITE_ESCROW_CONTRACT_ADDRESS=0x...
# # Circle's USDC on Base Sepolia
# VITE_USDC_CONTRACT_ADDRESS=0x036CbD53842c5426634e7929C8C4E5b8c0C5b6E8
# VITE_EXPLORER_URL=https://sepolia.basescan.org
